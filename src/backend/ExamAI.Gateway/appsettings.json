{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "ReverseProxy": {
    "Routes": {
      "identity": { "ClusterId": "identity", "Match": { "Path": "/api/v1/auth/{**catch-all}" } },
      "exams": { "ClusterId": "exams", "Match": { "Path": "/api/v1/exams/{**catch-all}" } },
      "billing": { "ClusterId": "billing", "Match": { "Path": "/api/v1/billing/{**catch-all}" } },
      "grading": { "ClusterId": "grading", "Match": { "Path": "/api/v1/grades/{**catch-all}" } },
      "analytics": { "ClusterId": "analytics", "Match": { "Path": "/api/v1/analytics/{**catch-all}" } },
      "admin": { "ClusterId": "admin", "Match": { "Path": "/api/v1/admin/{**catch-all}" } }
    },
    "Clusters": {
      "identity": { "Destinations": { "dest1": { "Address": "http://localhost:5126/" } } },
      "exams": { "Destinations": { "dest1": { "Address": "http://localhost:5002/" } } },
      "billing": { "Destinations": { "dest1": { "Address": "http://localhost:5003/" } } },
      "grading": { "Destinations": { "dest1": { "Address": "http://localhost:5004/" } } },
      "analytics": { "Destinations": { "dest1": { "Address": "http://localhost:5005/" } } },
      "admin": { "Destinations": { "dest1": { "Address": "http://localhost:5006/" } } }
    }
  }
}